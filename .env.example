# ============================================================
# Sanaa Through My Lens — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# The .env file is gitignored and will NOT be committed.
# ============================================================

# Database (SQLite for local development)
DATABASE_URL="file:./dev.db"

# Production MySQL (uncomment when deploying)
# DATABASE_URL="mysql://username:password@hostname:3306/database_name"

# NextAuth
NEXTAUTH_SECRET=change-me-to-a-secure-random-string-in-production
NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_URL=https://your-domain.com

# Root Domain (used by subdomain detection in middleware)
NEXT_PUBLIC_ROOT_DOMAIN=sanaathrumylens.co.ke

# Google OAuth (Reader sign-in)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Service (Nodemailer — mail.sanaathrumylens.co.ke)
EMAIL_HOST=mail.sanaathrumylens.co.ke
EMAIL_PORT=465
EMAIL_USER=verification@sanaathrumylens.co.ke
EMAIL_PASS=your-email-password
EMAIL_SECURE=true

# Legacy SMTP aliases (optional — used by some routes)
SMTP_HOST=mail.sanaathrumylens.co.ke
SMTP_PORT=465
SMTP_USER=verification@sanaathrumylens.co.ke
SMTP_PASS=your-email-password
SMTP_FROM="Sanaa Through My Lens <noreply@sanaathrumylens.co.ke>"

# CDN (Shared Hosting Media Storage)
CDN_BASE_URL=https://cdn.sanaathrumylens.co.ke
CDN_API_KEY=your-cdn-api-key-must-match-config-php

# Cron Key (for scheduled campaign processing — set a random string)
CRON_KEY=your-cron-secret-key

# VAPID Keys (for browser push notifications — generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ============================================================
# Deployment Tokens (DO NOT commit real tokens)
# ============================================================

# Vercel (for deployment)
# VERCEL_TOKEN=vcp_xxxxxxxxxxxxxxxxxxxx

# GitHub (for pushing code — use only temporarily)
# GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxx
